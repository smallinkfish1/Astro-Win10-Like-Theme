# ─────────────────────────────────────────────
#  一、依赖包
# ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─────────────────────────────────────────────
#  二、构建产物
# ─────────────────────────────────────────────
# npm run build 生成的静态网站文件。
dist/

# ─────────────────────────────────────────────
#  三、Astro 自己的缓存
# ─────────────────────────────────────────────
.astro/

# ─────────────────────────────────────────────
#  四、编辑器 / IDE 的本地配置
# ─────────────────────────────────────────────
.vscode/*

# JetBrains 全家桶（WebStorm / IDEA 等）
.idea/

# Vim / Neovim 的临时文件
*.swp
*.swo

# ─────────────────────────────────────────────
#  五、操作系统生成的垃圾文件
# ─────────────────────────────────────────────
# macOS 的 Finder 会在每个目录偷偷放一个 .DS_Store，
# 记录图标位置之类的东西。Windows 和 Linux 用户看到会很困惑。
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows 的缩略图缓存
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ─────────────────────────────────────────────
#  六、日志与临时文件
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器保存时留下的「未保存版本」
*.tmp
*.temp
*.bak
*.orig

# ─────────────────────────────────────────────
#  七、环境变量文件（⚠️ 涉及密钥，最重要的一条）
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production.local

# 不过 .env.example 要提交 —— 它是「模板」，
# 告诉别人需要配哪些变量，但里面的值是空的。
!.env.example


# ─────────────────────────────────────────────
#  八、这个项目特有的文件
# ─────────────────────────────────────────────

# 验收测试的产物（Playwright 跑失败时会生成截图和报告）
test-results/
playwright-report/
.playwright/
src/content/blog/



