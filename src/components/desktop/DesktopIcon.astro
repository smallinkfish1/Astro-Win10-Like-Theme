---
import { isImageIcon } from "../../lib/tiles";

interface Props {
  id: string;
  /** 中文名。构建期从词典取，见 Desktop.astro 的说明 */
  zh: string;
  /** 英文名。同上 */
  en: string;
  icon: string;
  path: string;
}
const { id, zh, en, icon, path } = Astro.props;

/**
 * 一个图标要么是 emoji（"🖥️"），要么是图片地址（"/icons/pc.png"）。
 *
 * 判断规则统一放在 lib/tiles.ts 的 isImageIcon 里，磁贴那边用同一套，
 * 免得两处规则跑偏（比如这边只认 / 开头、那边只认 http 开头）。
 */
const useImage = isImageIcon(icon);
---

<div
  class="os-icon group flex w-20 cursor-default flex-col items-center gap-1.5 rounded p-2
         transition-colors hover:bg-white/15 active:bg-white/25
         focus:bg-white/25 focus:outline-none"
  tabindex="0"
  role="button"
  data-icon-id={id}
  data-title={zh}
  data-icon={icon}
  data-path={path}
>
  <div class="grid h-11 w-11 place-items-center">
    {
      useImage ? (
        <img
          src={icon}
          alt=""
          width="44"
          height="44"
          draggable="false"
          class="h-11 w-11 object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,.5)]"
        />
      ) : (
        <span class="text-[30px] leading-none drop-shadow-[0_2px_4px_rgba(0,0,0,.5)]">{icon}</span>
      )
    }
  </div>
  {/*
    ⚠️ 中英两份都渲染，靠 CSS 按 <html lang> 显示其中一份
       （规则在 global.css，来龙去脉见 Desktop.astro 顶部）。

    ⚠️⚠️ 这里【故意不加】 aria-label。

       去掉它之后，role="button" 的可访问名就来自【可见文本】，
       而被 display:none 隐藏的那一份不会进入可访问性树 ——
       于是屏幕阅读器读到的永远是当前语言的那一份。

       反过来，如果硬写一个 aria-label，它只能是一种语言，
       等于把可访问名锁死了，切语言时不会跟着变。
  */}
  <span
    class="text-center text-[12px] leading-tight text-white
           [text-shadow:0_1px_3px_rgba(0,0,0,.95)]"
  >
    <span class="i18n-zh" lang="zh-CN">{zh}</span>
    <span class="i18n-en" lang="en">{en}</span>
  </span>
</div>

{/*
  ⚠️ 注意这里【没有】<script>。
  这个组件会被渲染很多次，如果每个实例都带 <script>，Astro 会把它们
  去重后在网格容器里留下一个真实 DOM 节点，而 CSS Grid 会把它算作一个格子，
  导致整排图标错位。所以事件监听统一放在 DesktopLayout.astro。

  ⚠️ 图片图标加了 draggable="false"。
  浏览器默认允许拖拽 <img>，拖起来是一张半透明的图片幽灵，
  在桌面上看起来就像"误触发了拖拽"。桌面图标本身不是可拖拽对象，直接关掉。
*/}
