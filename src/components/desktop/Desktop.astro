---
import DesktopIcon from "./DesktopIcon.astro";

/**
 * 桌面图标清单 —— 还原 Win10 默认桌面的五个图标。
 *
 * ⚠️ 这里的 id 必须能在 WindowManager 的 ICON_ROUTES 里找到同名的项，
 *    否则双击图标会派发事件、但窗口层不知道该开什么，表现为"没反应"。
 *
 * ⚠️ path 是"这个图标对应哪个静态页面"。因为项目要求每篇文章都有独立
 *    静态路由（SEO 需要），所以每次开窗口都会顺手 replaceState 到对应路径，
 *    刷新页面时 WindowManager 再按路径把窗口还原回来。
 *
 * 五个图标的分工：
 *   此电脑   → 仿资源管理器的文章列表（ExplorerView）
 *   记事本   → 纯文本读文章（NotepadView）
 *   浏览器   → 友情链接 + 社交主页（BrowserView）
 *   回收站   → 草稿箱（DraftsView）
 *   控制面板 → 外观设置，暗色模式/毛玻璃/动画三个开关（ControlPanelView）
 */
const icons = [
  { id: "pc", label: "此电脑", icon: "/icons/pc.png", path: "/archive" },
  { id: "notepad", label: "记事本", icon: "/icons/notepad.png", path: "/posts" },
  { id: "browser", label: "浏览器", icon: "/icons/browser.png", path: "/about" },
  { id: "recycle", label: "回收站", icon: "/icons/recycle.png", path: "/drafts" },
  { id: "control", label: "控制面板", icon: "/icons/control.png", path: "/settings" },
];
---

{/* 桌面图标区：底部留出任务栏高度，避免图标被压在任务栏下面 */}
<div class="absolute inset-0 p-3 pb-[calc(var(--taskbar-h)+12px)] pointer-events-none">
  {/*
    ⚠️ 这个 grid 里【只能】放图标，一个多余的节点都不行。
    Astro 会把 <script> 渲染成真实的 DOM 节点，而 display:none 的元素
    在 CSS Grid 里【依然占一个格子】。一旦 script 混进来，
    它会吃掉一个单元格，把后面所有图标整体挤歪。
    所以事件脚本统一放在 DesktopLayout.astro 里，不进这个容器。

    grid-rows-5：五个图标正好一列排满，不用换列。
    如果以后加图标超过 5 个，grid-flow-col 会自动往右开第二列，
    但那时候记得把行数改回去（比如 grid-rows-6/7），否则第二列会从中间断掉。
  */}
  <div
    class="desktop-grid pointer-events-auto grid auto-cols-max grid-flow-col grid-rows-5 gap-1"
  >
    {icons.map((i) => <DesktopIcon {...i} />)}
  </div>
</div>
