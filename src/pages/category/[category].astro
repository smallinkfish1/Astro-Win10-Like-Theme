---
import ContentLayout from "../../layouts/ContentLayout.astro";
import PostCard from "../../components/article/PostCard.astro";
import { getCategories, getPostsByCategory } from "../../lib/posts";
import { toClientPost } from "../../lib/markdown";

/** 每个分类预生成一份静态 HTML */
export async function getStaticPaths() {
  const categories = await getCategories();
  return await Promise.all(
    categories.map(async (c) => ({
      params: { category: c.name },
      props: { category: c.name, posts: await getPostsByCategory(c.name) },
    }))
  );
}

const { category, posts } = Astro.props;
const cards = posts.map(toClientPost);
const allCategories = await getCategories();
---

<ContentLayout
  title={`分类：${category}`}
  description={`分类「${category}」下有 ${posts.length} 篇文章。`}
  canonical={`/category/${encodeURIComponent(category)}`}
>
  <div class="mb-6">
    <a href="/tags" class="text-[12.5px] text-[var(--fg-faint)] no-underline hover:text-[var(--accent)]">
      ← 全部分类
    </a>
    <h1 class="mt-3 mb-0 text-[24px] font-semibold text-[var(--fg)]">
      📂 {category}
    </h1>
    <p class="mt-2 text-[13px] text-[var(--fg-dim)]">{posts.length} 篇文章</p>
  </div>

  <div class="flex flex-col gap-3">
    {cards.map((p) => <PostCard post={p} />)}
  </div>

  <nav class="mt-10 border-t border-[var(--surface-border)] pt-5">
    <p class="mb-2 text-[12px] text-[var(--fg-faint)]">其它分类</p>
    <div class="flex flex-wrap gap-1.5">
      {
        allCategories
          .filter((c) => c.name !== category)
          .map((c) => (
            <a href={`/category/${encodeURIComponent(c.name)}`} class="md-chip">
              📂 {c.name} <span class="ml-1 opacity-60">{c.count}</span>
            </a>
          ))
      }
    </div>
  </nav>
</ContentLayout>
