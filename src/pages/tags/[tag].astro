---
import ContentLayout from "../../layouts/ContentLayout.astro";
import PostCard from "../../components/article/PostCard.astro";
import { getTags, getPostsByTag } from "../../lib/posts";
import { toClientPost } from "../../lib/markdown";

/**
 * 单个标签的文章列表。
 *
 * 用 getStaticPaths 为每个标签预生成一份 HTML：
 *   /tags/前端/index.html
 *   /tags/Astro/index.html
 *   ...
 *
 * ⚠️ 中文标签要 encodeURIComponent，否则 URL 里会出现裸中文。
 *    浏览器能处理，但分享到某些平台会被截断，编码后更稳。
 */
export async function getStaticPaths() {
  const tags = await getTags();
  return await Promise.all(
    tags.map(async (t) => ({
      params: { tag: t.name },
      props: { tag: t.name, posts: await getPostsByTag(t.name) },
    }))
  );
}

const { tag, posts } = Astro.props;
const cards = posts.map(toClientPost);
const allTags = await getTags();
---

<ContentLayout
  title={`标签：${tag}`}
  description={`标签「${tag}」下有 ${posts.length} 篇文章。`}
  canonical={`/tags/${encodeURIComponent(tag)}`}
>
  <div class="mb-6">
    <a href="/tags" class="text-[12.5px] text-[var(--fg-faint)] no-underline hover:text-[var(--accent)]">
      ← 全部标签
    </a>
    <h1 class="mt-3 mb-0 text-[24px] font-semibold text-[var(--fg)]">
      <span class="text-[var(--fg-faint)]">#</span>{tag}
    </h1>
    <p class="mt-2 text-[13px] text-[var(--fg-dim)]">{posts.length} 篇文章</p>
  </div>

  <div class="flex flex-col gap-3">
    {cards.map((p) => <PostCard post={p} />)}
  </div>

  <nav class="mt-10 border-t border-[var(--surface-border)] pt-5">
    <p class="mb-2 text-[12px] text-[var(--fg-faint)]">其它标签</p>
    <div class="flex flex-wrap gap-1.5">
      {
        allTags
          .filter((t) => t.name !== tag)
          .map((t) => (
            <a
              href={`/tags/${encodeURIComponent(t.name)}`}
              class="md-chip"
            >
              #{t.name} <span class="ml-1 opacity-60">{t.count}</span>
            </a>
          ))
      }
    </div>
  </nav>
</ContentLayout>
