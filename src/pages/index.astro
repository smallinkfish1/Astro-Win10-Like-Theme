---
import DesktopLayout from "../layouts/DesktopLayout.astro";
import Desktop from "../components/desktop/Desktop.astro";
import WindowManager from "../components/window/WindowManager.tsx";
import Taskbar from "../components/taskbar/Taskbar.tsx";
import { getPosts, getDrafts, getCategories, getTags, getStats } from "../lib/posts";
import { getGuides } from "../lib/guide";
import { toClientPosts } from "../lib/markdown";

/**
 * 桌面首页。
 *
 * ⚠️ 这里是「Astro 构建期」和「React 运行时」的接缝，只做一件事：
 *    把构建期算好的数据序列化，喂给客户端岛屿。
 *
 *    为什么不能在岛屿里直接调用 getPosts()？
 *      因为 getPosts 依赖 astro:content 的编译期机制，在浏览器里跑会直接报错。
 *      数据只能「构建期算 → 序列化成 props → 运行时消费」。
 *
 *    所以下面这几个 await 在构建时执行一次，产物里留下的只是
 *    普通 HTML 和一份 JSON。
 */

const posts = toClientPosts(await getPosts(false));

/*
  ⚠️⚠️ 草稿这一份【要带 withRaw: true】，这是全场唯一一处传源码的地方。

     为什么只在这里传：
       回收站双击草稿要显示「原始 .md 源码」，所以它必须有 raw。
       而「此电脑」「标签页」那些地方双击是去渲染 HTML，
       完全用不到 raw —— 草稿正文可能几百 KB，
       全量传过去就是白白撑大首屏 JSON。

     换算一下：这篇 formula-draft.md 大约 2KB，
     加上本来就有的 draft-note.md，增量在个位数 KB。
     但如果以后草稿攒到几十篇，这个数字会线性增长 ——
     那时候就该改成按需 fetch 了（见 verify 里对 JSON 体积的断言）。
*/
const drafts = toClientPosts(await getDrafts(), { withRaw: true });

/** 浏览器「使用教程」标签页的内容，来自 src/content/guide/*.md
 *  ⚠️ 注意这里【没有 await】—— getGuides() 是同步函数。
 *     写成 await 虽然也能跑，但 astro check 会报 ts(80007) 警告。 */
const { guides } = getGuides();

const tags = await getTags();
const categories = await getCategories();
const stats = await getStats();
---

<DesktopLayout title="我的桌面">
  {/* 窗口层：react-rnd 用 bounds="parent" 把窗口限制在这个容器内，
      所以这个容器必须有定位上下文且铺满视口。

      ⚠️ 关键：client:load / client:only 会给组件套一层 <astro-island> 标签，
      而那层标签的实际尺寸是 0×0。如果 bounds 直接指向它，
      react-rnd 会把拖拽范围算成 0×0，窗口一拖就被钳回原点。
      所以这里用 client:only + 一个自己控制的满屏容器来当 bounds 目标。

      ⚠️⚠️ pointer-events: none 是必须的，别删。
      这两层都是 absolute inset-0（铺满视口）的透明盒子。
      透明不等于"点不到"——它们会拦下所有落在桌面上的鼠标事件，
      导致双击桌面图标毫无反应。所以：

        这两层       → pointer-events: none（让点击穿过去）
        窗口本体     → 在 Window.tsx 里显式写回 auto（把点击收回来）

      这样「窗口盖住的地方归窗口，空白处归桌面」才是对的。 */}
  <main class="pointer-events-none absolute inset-0" id="os-window-layer">
    <div class="pointer-events-none absolute inset-0">
      <WindowManager
        client:only="react"
        posts={posts}
        drafts={drafts}
        tags={tags}
        categories={categories}
        stats={stats}
        guides={guides}
      />
    </div>
  </main>

  {/* 桌面图标层：在 DOM 里排在窗口层之后，但窗口的 z-index 从 10 起，
      所以图标始终在窗口下方。

      ⚠️ 不再传 posts ——「创建快捷方式」功能暂时下线，
         桌面图标层只需要内置应用清单（来自 config/apps.ts）。 */}
  <Desktop />

  {/* 任务栏：固定在底部，z-index 100，压在窗口之上。
      开始菜单（z-110）再压在它之上。 */}
  <Taskbar client:only="react" categories={categories} tags={tags} />
</DesktopLayout>
